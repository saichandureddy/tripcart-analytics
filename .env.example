# -----------------------------------------------------------------------------
# TripCart local settings.
#
# Copy this file to .env (or run `make env`, which also generates the secrets)
# and change the passwords. .env is in .gitignore: never commit it.
#
# Use only letters, digits and underscores in passwords. Several values below are pasted
# into connection URLs, where characters like @ : / # would break them.
# -----------------------------------------------------------------------------

# --- App database: TripCart's operational system (the "source") --------------
APP_DB_USER=tripcart_app
APP_DB_PASSWORD=change_me_app
APP_DB_NAME=tripcart_app
# Port on your laptop; inside Docker it is 5432
APP_DB_PORT=5433

# --- Warehouse database: where raw data lands and dbt builds models -----------
DWH_DB_USER=tripcart_dwh
DWH_DB_PASSWORD=change_me_dwh
DWH_DB_NAME=tripcart_dwh
# Power BI and dbt on your laptop connect here
DWH_DB_PORT=5434

# --- MinIO: local S3-compatible storage for clickstream files -----------------
MINIO_ROOT_USER=tripcart
# At least 8 characters
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=tripcart-clickstream
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Airflow -----------------------------------------------------------------
# Your Linux user id, so files Airflow writes into ./airflow are owned by you.
# In WSL, run `id -u` (usually 1000). `make env` fills this in for you.
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow
AIRFLOW_DB_PASSWORD=change_me_airflow_db
# Encrypts connection passwords stored in Airflow's database.
# Generate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# Signs the tokens Airflow's components use to talk to each other.
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
